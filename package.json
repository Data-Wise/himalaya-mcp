{
  "name": "himalaya-mcp",
  "version": "2.1.2",
  "description": "MCP server wrapping himalaya CLI for privacy-first email access in Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "himalaya-mcp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=esm --minify && mkdir -p himalaya-mcp-plugin/dist && cp dist/index.js himalaya-mcp-plugin/dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "lint": "npm run build",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "pack": "bash scripts/build-mcpb.sh"
  },
  "keywords": [
    "mcp",
    "email",
    "himalaya",
    "claude",
    "claude-code-plugin"
  ],
  "author": "Data-Wise",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-html-markdown": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "tmp": "^0.2.7"
  }
}
