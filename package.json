{
  "name": "himalaya-mcp",
  "version": "2.0.0",
  "description": "MCP server wrapping himalaya CLI for privacy-first email access in Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "himalaya-mcp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=esm --minify",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "lint": "npm run build",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "pack": "npx @anthropic-ai/mcpb pack"
  },
  "keywords": [
    "mcp",
    "email",
    "himalaya",
    "claude",
    "claude-code-plugin"
  ],
  "author": "Data-Wise",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-html-markdown": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
