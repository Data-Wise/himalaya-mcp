{
  "name": "himalaya",
  "version": "2.0.1",
  "description": "Privacy-first email access for Claude via himalaya CLI \u2014 29 tools, 7 prompts, 3 resources, 16 skills, 2 hooks",
  "author": {
    "name": "Data-Wise"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/session-start.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_himalaya_email",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/pre-send.sh\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
